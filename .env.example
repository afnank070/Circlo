# CIRCLO environment — copy to .env and adjust. NEVER commit the real .env.
# Every value the app reads lives here; nothing environment-specific is in code.

# --- App ---
APP_ENV=development
# Generate a real one for prod, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me

# --- Database ---
# Credentials for the postgres container:
POSTGRES_USER=circlo
POSTGRES_PASSWORD=circlo
POSTGRES_DB=circlo
# DSN the app connects with. Host is the compose service name "postgres".
DATABASE_URL=postgresql+psycopg2://circlo:circlo@postgres:5432/circlo

# --- Object storage (S3-compatible: MinIO local, R2/S3 when deployed) ---
# Endpoint the APP uses to reach storage (compose service name "minio"):
STORAGE_ENDPOINT_URL=http://minio:9000
# Browser-facing base for presigned image URLs. In dev the browser hits MinIO on
# the host as localhost; in prod set this to your R2/S3 public domain. Presigned
# GET/PUT URLs are signed against this host so the browser can actually reach them.
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=circlo-public
STORAGE_BUCKET_PRIVATE=circlo-private
STORAGE_PRESIGN_EXPIRY=3600
STORAGE_USE_PATH_STYLE=true

# --- Cloudflare R2 (production values — swap in on Render, don't use locally) ---
# R2 uses virtual-hosted-style addressing automatically once STORAGE_ENDPOINT_URL
# contains "r2.cloudflarestorage.com" (see app/services/storage.py). R2 buckets
# are created manually in the Cloudflare dashboard, not via the app.
# STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=your_r2_access_key
# STORAGE_SECRET_KEY=your_r2_secret_key
# STORAGE_BUCKET=circlo-public
# STORAGE_BUCKET_PRIVATE=circlo-private
# STORAGE_PUBLIC_URL=https://pub-XXXX.r2.dev
# STORAGE_USE_PATH_STYLE=false

# --- Email: Brevo transactional API over HTTPS (transactional only, no SMS/OTP) ---
# We use Brevo's REST API (port 443), NOT SMTP — outbound SMTP (587/465) is
# blocked on the dev network and on Render.
# Create a free Brevo account -> SMTP & API -> "API Keys" tab -> generate a key.
# This is a v3 API KEY, different from the SMTP key. MAIL_FROM_ADDRESS must be a
# verified sender/domain in Brevo (Senders, Domains & Dedicated IPs) or mail is
# rejected. Leave BREVO_API_KEY / MAIL_FROM_ADDRESS blank in dev to disable
# sending (the app logs an error and no-ops instead of delivering).
BREVO_API_KEY=
# API endpoint — only override if Brevo changes it.
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
MAIL_FROM_ADDRESS=help@circlo.pk
MAIL_FROM_NAME=CIRCLO
# Canonical absolute base URL (no trailing slash). Used to build links inside
# emails AND the Google OAuth redirect URI, so it must match the domain
# registered in Google Cloud Console (e.g. https://www.circlo.pk).
PUBLIC_BASE_URL=http://localhost:5000
# app.logger level. Keep INFO so email send attempts/skips show in the log stream.
LOG_LEVEL=INFO

# --- Google OAuth2 ("Sign in with Google") ---
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
# -> "Web application". Add the authorized redirect URI:
#   http://localhost:5000/auth/google/callback   (local)
#   https://<your-domain>/auth/google/callback    (prod)
# Leave both blank to hide the Google button; email/password login is unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payment collection details (fallbacks) ---
# Where renters send the rental + deposit. These are only DEFAULTS for a fresh
# deploy; the live values are edited from /admin/settings (stored in the DB) once
# the real company account is ready. Leave blank until then.
PAYMENT_EASYPAISA_NUMBER=
PAYMENT_EASYPAISA_NAME=
PAYMENT_BANK_NAME=
PAYMENT_BANK_TITLE=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_IBAN=
PAYMENT_INSTRUCTIONS_NOTE=

# --- Host port overrides (only needed if a port is already taken locally) ---
APP_HOST_PORT=5000
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
