# CIRCLO environment — copy to .env and adjust. NEVER commit the real .env.
# Every value the app reads lives here; nothing environment-specific is in code.

# --- App ---
APP_ENV=development
# Generate a real one for prod, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me

# --- Database ---
# Credentials for the postgres container:
POSTGRES_USER=circlo
POSTGRES_PASSWORD=circlo
POSTGRES_DB=circlo
# DSN the app connects with. Host is the compose service name "postgres".
DATABASE_URL=postgresql+psycopg2://circlo:circlo@postgres:5432/circlo

# --- Object storage (S3-compatible: MinIO local, R2/S3 when deployed) ---
# Endpoint the APP uses to reach storage (compose service name "minio"):
STORAGE_ENDPOINT_URL=http://minio:9000
# Browser-facing base for presigned image URLs. In dev the browser hits MinIO on
# the host as localhost; in prod set this to your R2/S3 public domain. Presigned
# GET/PUT URLs are signed against this host so the browser can actually reach them.
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=circlo
STORAGE_BUCKET_PRIVATE=circlo-private
STORAGE_PRESIGN_EXPIRY=3600
STORAGE_USE_PATH_STYLE=true

# --- Host port overrides (only needed if a port is already taken locally) ---
APP_HOST_PORT=5000
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
